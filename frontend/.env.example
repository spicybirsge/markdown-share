# Public URLs are inlined into the browser bundle at build time, so they must
# use the NEXT_PUBLIC_ prefix. Without it client components fall back to the
# production defaults while server rendering still uses the real value.

# API origin (backend)
NEXT_PUBLIC_BACKEND_URL=http://localhost:5050

# Image proxy origin
NEXT_PUBLIC_PROXY_URL=https://cdn.shaheerahamed.com
